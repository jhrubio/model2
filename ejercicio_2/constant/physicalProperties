thermoType
{
    type            heSolidThermo;
    mixture         pureMixture;
    transport       constIsoSolid;
    thermo          eConst;
    equationOfState rhoConst;
    specie          specie;
    energy          sensibleInternalEnergy;
}

mixture
{
    specie
    {
        molWeight       56;
    }
    equationOfState
    {
        rho             7850;
    }
    transport
    {
        kappa           16;
    }
    thermodynamics
    {
        hf              0;
        Cv              490;
    }
}

